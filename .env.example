# Database
DATABASE_URL=postgres://oblivion:oblivion_dev@localhost:5432/oblivion
# docker-compose reads POSTGRES_PASSWORD for the postgres container; it MUST match
# the password embedded in DATABASE_URL above. deploy.sh generates a strong value.
POSTGRES_PASSWORD=oblivion_dev

# Redis
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092

# MinIO / S3
# In production set S3_ENDPOINT to the public storage URL (https://<STORAGE_DOMAIN>)
# so browser presigned upload URLs are reachable; deploy.sh does this when
# STORAGE_DOMAIN is provided. S3_ACCESS_KEY/S3_SECRET_KEY MUST match the
# MINIO_ROOT_USER/MINIO_ROOT_PASSWORD that docker-compose passes to the container.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET_RAW=oblivion-raw
S3_BUCKET_PROCESSED=oblivion-processed

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# JWT
# auth/case/notifier/reference read the key from these PEM paths. labs and
# billing instead require the public key *contents* in JWT_PUBLIC_KEY (below);
# scripts/run-all.sh exports it automatically from keys/public.pem.
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
# JWT_PUBLIC_KEY="$(cat keys/public.pem)"   # needed when running labs/billing directly
JWT_ACCESS_TOKEN_EXPIRY_SECS=3600
JWT_REFRESH_TOKEN_EXPIRY_SECS=604800

# Auth Service
AUTH_PORT=3001
AUTH_DB_SCHEMA=auth
AUTH_DB_MAX_CONNECTIONS=10

# Case Service
CASE_PORT=3002
CASE_DB_SCHEMA=cases
CASE_DB_MAX_CONNECTIONS=10
CASE_KAFKA_GROUP_ID=case-service

# Labs Service
LABS_PORT=3003
LABS_DB_SCHEMA=labs
LABS_DB_MAX_CONNECTIONS=10
LABS_KAFKA_GROUP_ID=labs-service
LABS_BILLING_URL=http://localhost:3007

# Recognition Service
RECOGNITION_PORT=3004
RECOGNITION_KAFKA_GROUP_ID=recognition-service

# Notifier Service
NOTIFIER_PORT=3005
NOTIFIER_DB_SCHEMA=notifier
NOTIFIER_DB_MAX_CONNECTIONS=10
NOTIFIER_KAFKA_GROUP_ID=notifier-service
NOTIFIER_SMTP_HOST=localhost
NOTIFIER_SMTP_PORT=1025
NOTIFIER_SMTP_FROM=noreply@oblivion.dev

# Reference Service
REFERENCE_PORT=3006
REFERENCE_DB_SCHEMA=reference
REFERENCE_DB_MAX_CONNECTIONS=10

# Billing Service
BILLING_PORT=3007
BILLING_DB_SCHEMA=billing
BILLING_DB_MAX_CONNECTIONS=10

# CORS
# Comma-separated list of browser origins allowed to call the API. Leave unset
# (or set to *) for permissive dev CORS. In production deploy.sh sets this to the
# frontend domain, e.g. CORS_ALLOWED_ORIGIN=https://frontend.example.com
CORS_ALLOWED_ORIGIN=

# Demo / test logins (seeded by scripts/seed-demo.sh after the backend is up).
# Passwords must be >= 8 chars (auth enforces this). Change these for a real deploy.
DEMO_DOCTOR_EMAIL=doctor@phenograph.test
DEMO_DOCTOR_PASSWORD=demopass123
DEMO_DOCTOR_NAME="Demo Doctor"
DEMO_DOCTOR_ORG="Demo Hospital"
DEMO_LAB_EMAIL=lab@phenograph.test
DEMO_LAB_PASSWORD=demopass123
DEMO_LAB_NAME="Demo Lab"
DEMO_LAB_ORG="Demo LabCo"

# Deployment domains (used by deploy.sh; A records must already point here).
# FRONTEND_DOMAIN serves the SPA, API_DOMAIN serves the gateway, STORAGE_DOMAIN
# (optional) reverse-proxies MinIO so browser presigned uploads work. If
# STORAGE_DOMAIN is set, deploy.sh points S3_ENDPOINT at it (above).
FRONTEND_DOMAIN=
API_DOMAIN=
STORAGE_DOMAIN=

# Logging
RUST_LOG=info
